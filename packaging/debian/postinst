#!/bin/sh
# postinst de libvirt-backup.
#
# Le paquet n'active JAMAIS la sauvegarde automatique de lui-même : l'emplacement des archives est un
# choix de l'utilisateur, demandé par « libvirt-backup install ». Une mise à jour redémarre en revanche
# le service déjà installé pour qu'il utilise le nouveau programme.
set -e

SERVICE=libvirt-config-backup-watch.service
UNIT=/etc/systemd/system/$SERVICE

# Vrai si l'unité présente est celle de cet outil (et non celle des anciens scripts shell).
ours() { [ -f "$UNIT" ] && grep -qx 'ExecStart=/usr/bin/libvirt-backup watch' "$UNIT"; }

case "$1" in
configure)
    # Une installation locale (« libvirt-backup install » depuis un binaire compilé) passe avant /usr/bin
    # dans le PATH et masquerait ce paquet : « install » lancé depuis /usr/bin la remplace.
    if [ -e /usr/local/bin/libvirt-backup ] || [ -d /usr/local/lib/libvirt-backup ]; then
        echo "libvirt-backup : une ancienne installation locale (/usr/local) masque ce paquet. Pour la remplacer :" >&2
        echo "    sudo /usr/bin/libvirt-backup install" >&2
        echo "libvirt-backup: an older local install (/usr/local) shadows this package; replace it with:  sudo /usr/bin/libvirt-backup install" >&2
    elif [ -z "$2" ]; then
        echo "libvirt-backup : pour activer la sauvegarde automatique (et choisir où ranger les archives) :" >&2
        echo "    sudo libvirt-backup install" >&2
        echo "libvirt-backup: to enable automatic backups (and choose where archives go), run:  sudo libvirt-backup install" >&2
    fi
    if ours && [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        # --no-block : l'établissement des surveillances inotify peut durer ; dpkg n'a pas à l'attendre.
        systemctl --no-block try-restart "$SERVICE" || true
    fi
    ;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
*)
    echo "postinst appelé avec un argument inconnu : $1" >&2
    exit 1
    ;;
esac

exit 0
